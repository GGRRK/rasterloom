{
  "canvas": {"w": 64, "h": 64, "bg": "#00000000"},
  "ops": [
    {"op": "add_layer", "id": "k", "fill": "gradient", "from": "#2040C0FF", "to": "#F0C020FF", "dir": "h"},
    {"op": "add_layer", "id": "u", "fill": "solid", "color": "#10E080FF", "rect": [8, 8, 32, 32]},
    {"op": "add_group", "id": "g"},
    {"op": "add_adjustment", "id": "a", "type": "invert", "parent": "g"},
    {"op": "set_fill", "layer": "a", "value": 0.5},
    {"op": "set_name", "layer": "u", "name": "Layer 1"},
    {"op": "set_name", "layer": "g", "name": "Group – ☀"},
    {"op": "set_name", "layer": "a", "name": "  spaced  "},
    {"op": "set_name", "layer": "u", "name": ""},
    {"op": "set_opacity", "layer": "u", "value": 0.5}
  ],
  "out": "png8"
}
