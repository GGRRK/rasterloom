{
  "canvas": {"w": 128, "h": 128, "bg": "#00000000"},
  "ops": [
    {"op": "add_layer", "id": "k", "fill": "noise", "seed": 3, "alpha": "random"},
    {"op": "add_group", "id": "g", "mode": "pass"},
    {"op": "set_opacity", "layer": "g", "value": 0.5},
    {"op": "add_layer", "id": "sc", "parent": "g", "fill": "gradient", "from": "#FF4000FF", "to": "#0040FFFF", "dir": "h", "rect": [16, 16, 96, 96]},
    {"op": "set_blend", "layer": "sc", "mode": "scrn"}
  ],
  "out": "png8"
}
