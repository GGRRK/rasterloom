{
  "canvas": {"w": 128, "h": 128, "bg": "#00000000"},
  "ops": [
    {"op": "add_layer", "id": "k", "fill": "gradient", "from": "#2040C0FF", "to": "#F0C020FF", "dir": "h"},
    {"op": "add_layer", "id": "u", "fill": "noise", "seed": 6, "alpha": "random"},
    {"op": "set_blend", "layer": "u", "mode": "over"},
    {"op": "set_fill", "layer": "u", "value": 0.8},
    {"op": "set_opacity", "layer": "u", "value": 0.5},
    {"op": "add_mask", "layer": "u", "fill": "noise", "seed": 12}
  ],
  "out": "png8"
}
