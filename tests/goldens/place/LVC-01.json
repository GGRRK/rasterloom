{
  "canvas": {"w": 64, "h": 64, "bg": "#00000000"},
  "ops": [
    {"op": "add_layer", "id": "k", "fill": "gradient", "from": "#2040C0FF", "to": "#F0C020FF", "dir": "h"},
    {"op": "add_layer", "id": "u", "fill": "noise", "seed": 7, "alpha": "random"},
    {"op": "select_ellipse", "x": 6.0, "y": 10.0, "w": 40.0, "h": 30.0, "antialias": true},
    {"op": "layer_via_copy", "id": "c", "layer": "u"},
    {"op": "set_visible", "layer": "u", "value": false}
  ],
  "out": "png8"
}
