{
  "canvas": {"w": 64, "h": 64, "bg": "#00000000"},
  "ops": [
    {"op": "add_layer", "id": "k", "fill": "gradient", "from": "#2040C0FF", "to": "#F0C020FF", "dir": "h"},
    {"op": "add_group", "id": "g", "mode": "scrn"},
    {"op": "set_opacity", "layer": "g", "value": 0.8},
    {"op": "add_mask", "layer": "g", "fill": "solid", "value": 255, "rect": [0, 0, 48, 64]},
    {"op": "add_layer", "id": "c1", "parent": "g", "fill": "solid", "color": "#10E080FF", "rect": [4, 4, 40, 40]},
    {"op": "add_layer", "id": "c2", "parent": "g", "fill": "noise", "seed": 4, "alpha": 255, "rect": [12, 12, 48, 48]},
    {"op": "set_clip", "layer": "c2", "value": true},
    {"op": "add_adjustment", "id": "a", "type": "invert", "parent": "g"},
    {"op": "set_fill", "layer": "a", "value": 0.5},
    {"op": "add_group", "id": "h", "parent": "g", "mode": "isolated"},
    {"op": "add_layer", "id": "d", "parent": "h", "fill": "solid", "color": "#E03020FF", "rect": [32, 24, 28, 28]},
    {"op": "duplicate_layer", "layer": "g", "id": "g2"},
    {"op": "set_visible", "layer": "g", "value": false},
    {"op": "set_opacity", "layer": "g2/c1", "value": 0.6},
    {"op": "set_fill", "layer": "g2/a", "value": 0.8},
    {"op": "set_blend", "layer": "g2/d", "mode": "over"},
    {"op": "set_opacity", "layer": "g2/h", "value": 0.7}
  ],
  "out": "png8"
}
