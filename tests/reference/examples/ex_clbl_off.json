    {"op": "add_layer", "id": "base", "fill": "gradient", "from": "#FF000000", "to": "#FF0000FF", "dir": "v", "rect": [8, 8, 48, 48]},
    {"op": "add_layer", "id": "c", "fill": "noise", "seed": 5, "alpha": 255},
    {"op": "set_clip", "layer": "c", "value": true},
    {"op": "set_blend", "layer": "c", "mode": "mul"},
