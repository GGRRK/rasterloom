    {"op": "add_layer", "id": "c1", "parent": "pg", "fill": "noise", "seed": 5, "alpha": 255},
    {"op": "add_adjustment", "id": "inv", "parent": "pg", "type": "invert", "params": {}},
    {"op": "set_clip", "layer": "c1", "value": true},
    {"op": "set_clip", "layer": "inv", "value": true},
    {"op": "set_blend", "layer": "c1", "mode": "mul"},
