    {"op": "add_mask", "layer": "pg", "fill": "solid", "value": 255, "rect": [5, 5, 70, 70], "outside": 64},
    {"op": "add_layer", "id": "late", "fill": "solid", "color": "#FFFFFF80", "rect": [0, 60, 80, 20]},
    {"op": "set_clip", "layer": "late", "value": true},
