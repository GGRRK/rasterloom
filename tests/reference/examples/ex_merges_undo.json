{ "canvas": {"w": 64, "h": 48, "bg": "#80808080"},
  "ops": [
    {"op": "add_layer", "id": "k", "fill": "gradient", "from": "#2040C0FF", "to": "#F0C020FF"},
    {"op": "add_layer", "id": "u", "fill": "noise", "seed": 2, "alpha": "random"},
    {"op": "set_blend", "layer": "u", "mode": "mul"},
    {"op": "set_opacity", "layer": "u", "value": 0.5},
    {"op": "add_mask", "layer": "u", "fill": "gradient", "from": 0, "to": 255},
    {"op": "merge_down", "layer": "u"},
    {"op": "set_opacity", "layer": "k", "value": 0.8},
    {"op": "add_layer", "id": "base", "fill": "solid", "color": "#FF0000C0", "rect": [10, 10, 30, 30]},
    {"op": "set_fill", "layer": "base", "value": 0.5},
    {"op": "add_layer", "id": "c", "fill": "noise", "seed": 5, "alpha": 255},
    {"op": "set_clip", "layer": "c", "value": true},
    {"op": "merge_down", "layer": "c"},
    {"op": "add_layer", "id": "hid", "fill": "solid", "color": "#00FF00FF", "rect": [0, 0, 20, 20]},
    {"op": "add_layer", "id": "top", "fill": "solid", "color": "#0000FF80", "rect": [30, 20, 30, 20]},
    {"op": "set_blend", "layer": "top", "mode": "scrn"},
    {"op": "set_visible", "layer": "hid", "value": false},
    {"op": "move_layer", "id": "hid", "index": 0},
    {"op": "merge_visible", "id": "mv"},
    {"op": "set_visible", "layer": "hid", "value": true},
    {"op": "add_layer", "id": "junk", "fill": "solid", "color": "#FFFFFFFF"},
    {"op": "set_blend", "layer": "junk", "mode": "diff"},
    {"op": "undo", "steps": 2},
    {"op": "add_layer", "id": "junk2", "fill": "solid", "color": "#FF00FFFF", "rect": [0, 0, 8, 8]},
    {"op": "undo"},
    {"op": "flatten", "id": "flat"}
  ],
  "out": "png8" }
