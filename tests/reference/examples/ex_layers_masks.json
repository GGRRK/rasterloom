{ "canvas": {"w": 96, "h": 64, "bg": "#204060FF"},
  "ops": [
    {"op": "add_layer", "id": "empty", "rect": [4, 4, 8, 8]},
    {"op": "add_layer", "id": "solid", "fill": "solid", "color": "#FF800080", "rect": [-8, -8, 40, 40]},
    {"op": "add_layer", "id": "grad", "fill": "gradient", "from": "#00FF0000", "to": "#FF00FFFF", "dir": "v", "rect": [30, 0, 30, 64]},
    {"op": "add_layer", "id": "chk", "fill": "checker", "a": "#FFFFFF", "b": "#0000FF80", "cell": 5, "rect": [50, 10, 40, 40]},
    {"op": "add_layer", "id": "nz", "fill": "noise", "seed": 3, "alpha": "random", "rect": [0, 40, 96, 24]},
    {"op": "add_layer", "id": "nz2", "fill": "noise", "seed": 4, "alpha": 200, "rect": [70, 0, 26, 30]},
    {"op": "add_mask", "layer": "nz", "fill": "gradient", "from": 255, "to": 0, "dir": "h"},
    {"op": "add_mask", "layer": "chk", "fill": "noise", "seed": 9, "rect": [55, 15, 20, 20], "outside": 128},
    {"op": "add_mask", "layer": "grad", "fill": "solid", "value": 100, "rect": [30, 0, 30, 32], "outside": 255},
    {"op": "set_mask_enabled", "layer": "grad", "value": false},
    {"op": "set_mask_enabled", "layer": "grad", "value": true},
    {"op": "add_mask", "layer": "nz2"},
    {"op": "delete_mask", "layer": "nz2"},
    {"op": "apply_mask", "layer": "chk"},
    {"op": "lock_transparency", "layer": "solid"},
    {"op": "lock_transparency", "layer": "solid", "value": false},
    {"op": "set_fill", "layer": "solid", "value": 0.6},
    {"op": "set_opacity", "layer": "solid", "value": 0.7},
    {"op": "set_visible", "layer": "empty", "value": false},
    {"op": "set_blend", "layer": "nz2", "mode": "hue"}
  ],
  "out": "png8" }
